# Deployment Configuration
# Copy this file to .env and fill in values. The .env file is gitignored.
#
#   cp infra/.env.example infra/.env
#   bash infra/deploy.sh

# --- Resource Group ---
RG_NAME=millets-momo-rg
LOCATION=centralindia
BASE_NAME=millets-momo

# --- Database (Supabase) ---
# The database is not provisioned by Azure. Copy this from the Supabase
# dashboard: Connect → Transaction pooler (the shared one, port 6543).
# The shared pooler is reachable over IPv4; the direct connection is not,
# and Azure Functions has no IPv6 egress.
# Percent-encode any special characters in the password.
DATABASE_URL=

# --- Database tuning (all optional) ---
# DB_POOL_MAX=5                 max pooled connections per Functions instance
# DB_CONNECT_TIMEOUT_MS=15000   how long to wait for a connection
# DB_STATEMENT_TIMEOUT_MS=20000 server-side cap on a single statement
# DB_SSL_STRICT=false           true verifies the TLS chain (needs a CA bundle)

# --- Auth ---
# HMAC secret for API tokens. Leave empty to auto-generate on first deploy
MM_TOKEN_SECRET=

# --- SWA / GitHub ---
# GitHub repo in owner/repo format (e.g. "myorg/millets-momo")
REPO_URL=

# GitHub PAT with repo access. Required for SWA CI/CD
REPOSITORY_TOKEN=

# Git branch to deploy
BRANCH=main

# --- CORS ---
# Allowed origins, comma-separated. Leave empty to auto-detect from SWA hostname
ALLOWED_ORIGINS=
